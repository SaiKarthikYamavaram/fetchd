{
  "manifest_version": 3,
  "name": "fetchd integration",
  "version": "1.1.0",
  "description": "Send downloads to fetchd with the browser's cookies. Detects media on a page, grabs all links or images, and routes captured downloads by file type.",
  "permissions": [
    "cookies",
    "contextMenus",
    "downloads",
    "notifications",
    "storage",
    "webRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "fetchd",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
